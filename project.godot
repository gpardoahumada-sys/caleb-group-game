; ---------------------------------------------------------------------------
;  CALEB GROUP - juego de formacion comercial
;  Torre Caleb Group, Acto 1. Cada piso del edificio es una escena y un JSON de
;  datos (data/oficina_XX.json): la logica es la misma, lo que cambia es el plano,
;  el mobiliario y los textos. Ver README.md.
; ---------------------------------------------------------------------------

config_version=5

[application]

config/name="Caleb Group"
config/description="Serious game de formacion comercial: la Torre Caleb Group y los clientes del Acto 2."
run/main_scene="res://scenes/building/oficina_01.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameState="*res://autoload/game_state.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

